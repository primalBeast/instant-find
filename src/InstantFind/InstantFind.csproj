<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>InstantFind</AssemblyName>
    <RootNamespace>InstantFind</RootNamespace>
    <Product>Instant Find</Product>
    <Company>primalBeast</Company>
    <Copyright>Copyright (c) 2026 primalBeast</Copyright>
    <Description>Crowdstrike-friendly instant filename search for Windows. User-mode only — no drivers, no MFT/USN access.</Description>
    <Version>1.0.5</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

</Project>
