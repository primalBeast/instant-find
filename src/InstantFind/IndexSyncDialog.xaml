<Window x:Class="InstantFind.IndexSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instant Find"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Border Padding="20" Background="{StaticResource BgBrush}">
    <StackPanel MaxWidth="480">
      <TextBlock x:Name="MessageText"
                 TextWrapping="Wrap"
                 FontSize="14"
                 Margin="0,0,0,18"
                 Foreground="{StaticResource FgBrush}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Yes" IsDefault="True" Click="Yes_Click"
                MinWidth="80" Padding="14,6" Margin="0,0,8,0"
                Background="{StaticResource AccentBrush}" Foreground="White"
                BorderThickness="0" Cursor="Hand"/>
        <Button Content="_No" Click="No_Click"
                MinWidth="80" Padding="14,6" Margin="0,0,8,0"
                Background="{StaticResource PanelBrush}" Foreground="{StaticResource FgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
        <Button Content="_Cancel" IsCancel="True" Click="Cancel_Click"
                MinWidth="80" Padding="14,6"
                Background="{StaticResource PanelBrush}" Foreground="{StaticResource FgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
