<Window x:Class="InstantFind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instant Find"
        Height="640" Width="960"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="12">
    <!-- Header: title + And/Or + rebuild -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
        <TextBlock Text="Instant Find"
                   FontSize="20" FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"/>
        <CheckBox Content="And"
                  IsChecked="{Binding IsAndChecked}"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0"
                  Foreground="{StaticResource FgBrush}"
                  ToolTip="All terms must match (default)"/>
        <CheckBox Content="Or"
                  IsChecked="{Binding IsOrChecked}"
                  VerticalAlignment="Center"
                  Foreground="{StaticResource FgBrush}"
                  ToolTip="Any term may match. Both And and Or off = literal spaces in the name."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Rebuild Index"
                Command="{Binding RebuildIndexCommand}"
                Padding="12,6" Margin="0,0,8,0"
                Background="{StaticResource AccentBrush}"
                Foreground="White" BorderThickness="0"
                Cursor="Hand"/>
        <Button Content="Cancel"
                Command="{Binding CancelIndexCommand}"
                Padding="12,6"
                Background="{StaticResource PanelBrush}"
                Foreground="{StaticResource FgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                Cursor="Hand"/>
      </StackPanel>
    </DockPanel>

    <!-- Search bar: clear / Match Case / Whole Word / box / spinner -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6,4"
            Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
                Content="✕"
                Command="{Binding ClearQueryCommand}"
                Width="20" Height="20"
                Margin="0,0,4,0"
                FontSize="10" FontWeight="Bold"
                Foreground="#E81123"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Clear search"
                VerticalAlignment="Center"/>

        <ToggleButton Grid.Column="1"
                      Content="Aa"
                      IsChecked="{Binding MatchCase}"
                      MinWidth="26" Height="22"
                      Padding="6,2"
                      Margin="0,0,4,0"
                      FontSize="11"
                      FontWeight="SemiBold"
                      HorizontalContentAlignment="Center"
                      ClipToBounds="False"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource FgBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      ToolTip="Match Case"
                      Cursor="Hand"
                      VerticalAlignment="Center"/>

        <ToggleButton Grid.Column="2"
                      Content="W"
                      IsChecked="{Binding WholeWord}"
                      MinWidth="24" Height="22"
                      Padding="6,2"
                      Margin="0,0,6,0"
                      FontSize="11"
                      FontWeight="SemiBold"
                      HorizontalContentAlignment="Center"
                      ClipToBounds="False"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource FgBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      ToolTip="Whole Word"
                      Cursor="Hand"
                      VerticalAlignment="Center"/>

        <TextBox x:Name="SearchBox"
                 Grid.Column="3"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16"
                 Background="Transparent"
                 Foreground="{StaticResource FgBrush}"
                 BorderThickness="0"
                 CaretBrush="{StaticResource FgBrush}"
                 VerticalContentAlignment="Center"/>

        <!-- Circular busy ring: rotates while IsSearching (user search only) -->
        <Viewbox Grid.Column="4"
                 Width="20" Height="20"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
          <Canvas Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
              <RotateTransform Angle="0"/>
            </Canvas.RenderTransform>
            <Canvas.Style>
              <Style TargetType="Canvas">
                <Style.Triggers>
                  <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                      <BeginStoryboard x:Name="SpinnerSpin">
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                              From="0" To="360"
                              Duration="0:0:0.75"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                      <StopStoryboard BeginStoryboardName="SpinnerSpin"/>
                    </Trigger.ExitActions>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Canvas.Style>
            <!-- Soft track ring -->
            <Ellipse Canvas.Left="1" Canvas.Top="1"
                     Width="18" Height="18"
                     Stroke="#3F3F46" StrokeThickness="2.5"/>
            <!-- Accent arc (~270°) -->
            <Path Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="2.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M 10,2 A 8,8 0 1 1 2.34,12.34"/>
          </Canvas>
        </Viewbox>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top"
               Text="Filters: substrings, * and ? wildcards, ext:pdf  ·  And/Or/literal spaces  ·  Enter/double-click open  ·  Ctrl+Enter open folder"
               Foreground="{StaticResource MutedBrush}"
               FontSize="11"
               Margin="0,0,0,8"
               TextWrapping="Wrap"/>

    <!-- Status + drive chips -->
    <StatusBar DockPanel.Dock="Bottom"
               Background="{StaticResource PanelBrush}"
               Foreground="{StaticResource MutedBrush}"
               Margin="0,8,0,0">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <StatusBarItem Grid.Column="0">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
      </StatusBarItem>
      <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
        <ItemsControl ItemsSource="{Binding DriveChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton Content="{Binding Letter}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            Margin="4,0,0,0"
                            Padding="8,2"
                            MinWidth="36"
                            FontWeight="SemiBold"
                            Background="{StaticResource PanelBrush}"
                            Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Cursor="Hand"
                            ToolTip="Toggle drive in results / rebuild"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StatusBarItem>
    </StatusBar>

    <!-- Results -->
    <DataGrid x:Name="ResultsGrid"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedItem}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeRows="False"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              RowHeaderWidth="0"
              Background="{StaticResource BgBrush}"
              Foreground="{StaticResource FgBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              RowBackground="{StaticResource BgBrush}"
              AlternatingRowBackground="{StaticResource PanelBrush}"
              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
              MouseDoubleClick="ResultsGrid_MouseDoubleClick"
              PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown">
      <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
          <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
          <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="6,2"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Path" Binding="{Binding Directory}" Width="3*"/>
        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90"/>
        <DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDisplay}" Width="140"/>
      </DataGrid.Columns>
      <DataGrid.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="ResultsContextMenu_Opened"
                     Closed="ResultsContextMenu_Closed">
          <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
          <MenuItem Header="Open Containing Folder" Command="{Binding OpenFolderCommand}"/>
          <MenuItem Header="Edit with Notepad++" Command="{Binding EditWithNotepadPpCommand}"/>
          <MenuItem Header="Open path in Command Prompt" Command="{Binding OpenInCmdCommand}"/>
          <MenuItem Header="Open path in Git Bash" Command="{Binding OpenInGitBashCommand}"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OpenFolderCommand}"/>
      </DataGrid.InputBindings>
    </DataGrid>
  </DockPanel>
</Window>
