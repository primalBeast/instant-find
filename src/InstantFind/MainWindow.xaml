<Window x:Class="InstantFind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instant Find"
        Height="640" Width="960"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="12">
    <!-- Header -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="Instant Find"
                 FontSize="20" FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Rebuild Index"
                Command="{Binding RebuildIndexCommand}"
                Padding="12,6" Margin="0,0,8,0"
                Background="{StaticResource AccentBrush}"
                Foreground="White" BorderThickness="0"
                Cursor="Hand"/>
        <Button Content="Cancel"
                Command="{Binding CancelIndexCommand}"
                Padding="12,6"
                Background="{StaticResource PanelBrush}"
                Foreground="{StaticResource FgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                Cursor="Hand"/>
      </StackPanel>
    </DockPanel>

    <!-- Search box + spinner -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,6"
            Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox"
                 Grid.Column="0"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16"
                 Background="Transparent"
                 Foreground="{StaticResource FgBrush}"
                 BorderThickness="0"
                 CaretBrush="{StaticResource FgBrush}"
                 VerticalContentAlignment="Center"/>
        <ProgressBar Grid.Column="1"
                     Width="22" Height="22"
                     Margin="8,0,0,0"
                     IsIndeterminate="True"
                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top"
               Text="Filters: substrings, * and ? wildcards, ext:pdf  ·  Enter/double-click open  ·  Ctrl+Enter open folder"
               Foreground="{StaticResource MutedBrush}"
               FontSize="11"
               Margin="0,0,0,8"
               TextWrapping="Wrap"/>

    <!-- Status -->
    <StatusBar DockPanel.Dock="Bottom"
               Background="{StaticResource PanelBrush}"
               Foreground="{StaticResource MutedBrush}"
               Margin="0,8,0,0">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding IndexedRootsDisplay}" Opacity="0.7"/>
      </StatusBarItem>
    </StatusBar>

    <!-- Results -->
    <DataGrid x:Name="ResultsGrid"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedItem}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeRows="False"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              RowHeaderWidth="0"
              Background="{StaticResource BgBrush}"
              Foreground="{StaticResource FgBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              RowBackground="{StaticResource BgBrush}"
              AlternatingRowBackground="{StaticResource PanelBrush}"
              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
              MouseDoubleClick="ResultsGrid_MouseDoubleClick">
      <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
          <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
          <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="6,2"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Path" Binding="{Binding Directory}" Width="3*"/>
        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90"/>
        <DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDisplay}" Width="140"/>
      </DataGrid.Columns>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
          <MenuItem Header="Open Containing Folder" Command="{Binding OpenFolderCommand}"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OpenFolderCommand}"/>
      </DataGrid.InputBindings>
    </DataGrid>
  </DockPanel>
</Window>
