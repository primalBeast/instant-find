<Window x:Class="InstantFind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instant Find"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="640" Width="960"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="12">
    <!-- Header: title + rebuild + help -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button Content="?"
              Click="HelpButton_Click"
              Width="28" Height="28"
              Margin="8,0,0,0"
              FontSize="14" FontWeight="Bold"
              DockPanel.Dock="Right"
              VerticalAlignment="Center"
              Cursor="Hand"
              ToolTip="Help"
              Background="{StaticResource PanelBrush}"
              Foreground="{StaticResource FgBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              SnapsToDevicePixels="True">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14"
                    Width="28" Height="28"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
      <Button Content="{Binding IndexButtonText}"
              Command="{Binding IndexButtonCommand}"
              Padding="12,6"
              MinWidth="128"
              Margin="0,0,0,0"
              DockPanel.Dock="Right"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Cursor="Hand"
              FontWeight="SemiBold"
              BorderThickness="1"
              SnapsToDevicePixels="True">
        <Button.Style>
          <Style TargetType="Button">
            <!-- Idle: solid accent (never blank system chrome) -->
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="3"
                          Padding="{TemplateBinding Padding}"
                          SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <!-- Indexing: danger / accent-outline Cancel -->
              <DataTrigger Binding="{Binding IsIndexing}" Value="True">
                <Setter Property="Background" Value="#2D1E1E"/>
                <Setter Property="Foreground" Value="#F14C4C"/>
                <Setter Property="BorderBrush" Value="#F14C4C"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=AppVersion}"
                 FontSize="12"
                 Foreground="{StaticResource MutedBrush}"
                 VerticalAlignment="Center"
                 Margin="0,0,6,0"/>
      <TextBlock Text="Instant Find"
                 FontSize="20" FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Margin="0,0,16,0"/>
    </DockPanel>

    <!-- Search bar: ✕ / Aa / W / .* / box / And / Or / spinner -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6,4"
            Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
                Content="✕"
                Command="{Binding ClearQueryCommand}"
                Width="20" Height="20"
                Margin="0,0,4,0"
                FontSize="10" FontWeight="Bold"
                Foreground="#E81123"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Clear search"
                VerticalAlignment="Center"/>

        <ToggleButton Grid.Column="1"
                      Content="Aa"
                      IsChecked="{Binding MatchCase}"
                      MinWidth="26" Height="22"
                      Padding="6,2"
                      Margin="0,0,4,0"
                      FontSize="11"
                      FontWeight="SemiBold"
                      HorizontalContentAlignment="Center"
                      ClipToBounds="False"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource FgBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      ToolTip="Match Case"
                      Cursor="Hand"
                      VerticalAlignment="Center"/>

        <ToggleButton Grid.Column="2"
                      Content="W"
                      IsChecked="{Binding WholeWord}"
                      MinWidth="24" Height="22"
                      Padding="6,2"
                      Margin="0,0,4,0"
                      FontSize="11"
                      FontWeight="SemiBold"
                      HorizontalContentAlignment="Center"
                      ClipToBounds="False"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource FgBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      ToolTip="Whole Word"
                      Cursor="Hand"
                      VerticalAlignment="Center"/>

        <ToggleButton Grid.Column="3"
                      Content=".*"
                      IsChecked="{Binding UseRegex}"
                      MinWidth="28" Height="22"
                      Padding="6,2"
                      Margin="0,0,6,0"
                      FontSize="11"
                      FontFamily="Consolas"
                      FontWeight="SemiBold"
                      HorizontalContentAlignment="Center"
                      ClipToBounds="False"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource FgBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      ToolTip="Regex (filename; .NET). Case follows Aa. Leaves FTS."
                      Cursor="Hand"
                      VerticalAlignment="Center"/>

        <TextBox x:Name="SearchBox"
                 Grid.Column="4"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16"
                 Background="Transparent"
                 Foreground="{StaticResource FgBrush}"
                 BorderThickness="0"
                 CaretBrush="{StaticResource FgBrush}"
                 VerticalContentAlignment="Center"
                 Margin="0,0,8,0"/>

        <!-- Filter button + anchored popup (left of And/Or) -->
        <Grid Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0">
          <ToggleButton x:Name="FilterButton"
                        Content="Filter"
                        IsChecked="{Binding IsFilterPopupOpen, Mode=TwoWay}"
                        MinWidth="52" Height="22"
                        Padding="8,2"
                        FontSize="11"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        Background="{StaticResource PanelBrush}"
                        Foreground="{StaticResource FgBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Cursor="Hand"
                        ToolTip="Size, date, type, excludes, and saved filters"
                        VerticalAlignment="Center">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ToggleButton.Style>
          </ToggleButton>
          <Popup IsOpen="{Binding IsFilterPopupOpen, Mode=TwoWay}"
                 PlacementTarget="{Binding ElementName=FilterButton}"
                 Placement="Left"
                 HorizontalOffset="-4"
                 StaysOpen="False"
                 AllowsTransparency="True"
                 PopupAnimation="Fade">
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    MinWidth="300" MaxWidth="380"
                    MaxHeight="560">
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
              </Border.Effect>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Filters" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource FgBrush}"
                               VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            Content="Clear filters"
                            Command="{Binding ClearStructuredFiltersCommand}"
                            Padding="8,2"
                            FontSize="11"
                            Background="Transparent"
                            Foreground="{StaticResource AccentBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Right"/>
                  </DockPanel>

                  <TextBlock Text="Size" FontWeight="SemiBold" FontSize="11"
                             Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                  <WrapPanel Margin="0,0,0,10">
                    <Button Content="&gt; 1 MB" Command="{Binding ApplySizeFilterCommand}" CommandParameter="&gt;1mb"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                    <Button Content="&gt; 10 MB" Command="{Binding ApplySizeFilterCommand}" CommandParameter="&gt;10mb"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                    <Button Content="&gt; 100 MB" Command="{Binding ApplySizeFilterCommand}" CommandParameter="&gt;100mb"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                    <Button Content="&lt; 100 KB" Command="{Binding ApplySizeFilterCommand}" CommandParameter="&lt;100kb"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                    <Button Content="1–10 MB" Command="{Binding ApplySizeFilterCommand}" CommandParameter="1mb..10mb"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                  </WrapPanel>

                  <TextBlock Text="Date modified" FontWeight="SemiBold" FontSize="11"
                             Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                  <WrapPanel Margin="0,0,0,10">
                    <Button Content="Today" Command="{Binding ApplyDateFilterCommand}" CommandParameter="today"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                    <Button Content="This week" Command="{Binding ApplyDateFilterCommand}" CommandParameter="thisweek"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                    <Button Content="This month" Command="{Binding ApplyDateFilterCommand}" CommandParameter="thismonth"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                    <Button Content="This year" Command="{Binding ApplyDateFilterCommand}" CommandParameter="thisyear"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                    <Button Content="Yesterday" Command="{Binding ApplyDateFilterCommand}" CommandParameter="yesterday"
                            Margin="0,0,6,6" Padding="8,3" FontSize="11"
                            Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                  </WrapPanel>

                  <TextBlock Text="Type" FontWeight="SemiBold" FontSize="11"
                             Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding TypeFilterGroups}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding DisplayName}"
                                Command="{Binding DataContext.ApplyTypeFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Key}"
                                Margin="0,0,6,6" Padding="8,3" FontSize="11"
                                Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                                BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"
                                ToolTip="{Binding Key, StringFormat={}{0}:}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>


                  <DockPanel Margin="0,8,0,4">
                    <TextBlock Text="Exclude" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            Content="+"
                            Command="{Binding AddCustomExcludeCommand}"
                            Width="24" Height="22"
                            FontSize="14" FontWeight="Bold"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            ToolTip="Add a folder to exclude"/>
                  </DockPanel>
                  <TextBlock Text="Common folders" FontSize="10"
                             Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding CommonExcludes}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Content="{Binding Label}"
                                  Margin="0,0,0,3"
                                  FontSize="11"
                                  Foreground="{StaticResource FgBrush}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Your folders" FontSize="10"
                             Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding CustomExcludePaths}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Content="✕"
                                  Command="{Binding DataContext.RemoveCustomExcludeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  Width="22" Height="20" FontSize="10"
                                  Background="Transparent" Foreground="#E81123"
                                  BorderThickness="0" Cursor="Hand" ToolTip="Remove exclude"/>
                          <TextBlock Text="{Binding}" FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{StaticResource FgBrush}"
                                     VerticalAlignment="Center"
                                     ToolTip="{Binding}"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="Saved filters" FontWeight="SemiBold" FontSize="11"
                             Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Save"
                            Command="{Binding SaveCurrentFilterCommand}"
                            Padding="10,3" FontSize="11" Margin="6,0,0,0"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                    <TextBox Text="{Binding NewFilterName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12"
                             Background="{StaticResource BgBrush}"
                             Foreground="{StaticResource FgBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             CaretBrush="{StaticResource FgBrush}"
                             Padding="4,3"
                             ToolTip="Name for the current query"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding SavedFilters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Content="✕"
                                  Command="{Binding DataContext.DeleteSavedFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  Width="22" Height="20" FontSize="10"
                                  Background="Transparent" Foreground="#E81123"
                                  BorderThickness="0" Cursor="Hand" ToolTip="Delete saved filter"/>
                          <Button Content="{Binding Name}"
                                  Command="{Binding DataContext.ActivateSavedFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  HorizontalContentAlignment="Left"
                                  Padding="8,3" FontSize="11"
                                  Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"
                                  ToolTip="{Binding Query}"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>

        <!-- Right-justified match mode (mutual exclusive; both off = literal spaces) -->
        <CheckBox Grid.Column="6"
                  Content="And"
                  IsChecked="{Binding IsAndChecked}"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0"
                  Foreground="{StaticResource FgBrush}"
                  ToolTip="All terms must match (default)"/>
        <CheckBox Grid.Column="7"
                  Content="Or"
                  IsChecked="{Binding IsOrChecked}"
                  VerticalAlignment="Center"
                  Margin="0,0,4,0"
                  Foreground="{StaticResource FgBrush}"
                  ToolTip="Any term may match. Both And and Or off = literal spaces in the name."/>

        <!-- Circular busy ring: rotates while IsSearching (user search only) -->
        <Viewbox Grid.Column="8"
                 Width="20" Height="20"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
          <Canvas Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
              <RotateTransform Angle="0"/>
            </Canvas.RenderTransform>
            <Canvas.Style>
              <Style TargetType="Canvas">
                <Style.Triggers>
                  <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                      <BeginStoryboard x:Name="SpinnerSpin">
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                              From="0" To="360"
                              Duration="0:0:0.75"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                      <StopStoryboard BeginStoryboardName="SpinnerSpin"/>
                    </Trigger.ExitActions>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Canvas.Style>
            <!-- Soft track ring -->
            <Ellipse Canvas.Left="1" Canvas.Top="1"
                     Width="18" Height="18"
                     Stroke="#3F3F46" StrokeThickness="2.5"/>
            <!-- Accent arc (~270°) -->
            <Path Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="2.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M 10,2 A 8,8 0 1 1 2.34,12.34"/>
          </Canvas>
        </Viewbox>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top"
               Text="Filters: substrings, * ? wildcards, !NOT, ext:/doc:/img:, size:, dm:, .* regex, C:\path\ scope  ·  Filter popup  ·  And/Or/literal  ·  drag out  ·  Enter open"
               Foreground="{StaticResource MutedBrush}"
               FontSize="11"
               Margin="0,0,0,8"
               TextWrapping="Wrap"/>

    <!-- Status + drive chips -->
    <StatusBar DockPanel.Dock="Bottom"
               Background="{StaticResource PanelBrush}"
               Foreground="{StaticResource MutedBrush}"
               Margin="0,8,0,0">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <StatusBarItem Grid.Column="0">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
      </StatusBarItem>
      <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
        <ItemsControl ItemsSource="{Binding DriveChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton Content="{Binding Letter}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            Margin="4,0,0,0"
                            Padding="8,2"
                            MinWidth="36"
                            FontWeight="SemiBold"
                            Background="{StaticResource PanelBrush}"
                            Foreground="{StaticResource FgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Cursor="Hand"
                            ToolTip="Toggle drive in results"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StatusBarItem>
    </StatusBar>

    <!-- Results -->
    <DataGrid x:Name="ResultsGrid"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedItem}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeRows="False"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              RowHeaderWidth="0"
              Background="{StaticResource BgBrush}"
              Foreground="{StaticResource FgBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              RowBackground="{StaticResource BgBrush}"
              AlternatingRowBackground="{StaticResource PanelBrush}"
              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
              MouseDoubleClick="ResultsGrid_MouseDoubleClick"
              PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown"
              PreviewMouseLeftButtonDown="ResultsGrid_PreviewMouseLeftButtonDown"
              MouseMove="ResultsGrid_MouseMove">
      <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
          <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
          <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="6,2"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn x:Name="ExtensionColumn" Header="Extension" Binding="{Binding Extension}" Width="80"
                           Visibility="Collapsed"/>
        <DataGridTextColumn Header="Path" Binding="{Binding Directory}" Width="3*"/>
        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90"/>
        <DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDisplay}" Width="140"/>
        <DataGridTextColumn x:Name="AttributesColumn" Header="Attributes" Binding="{Binding AttributesDisplay}" Width="90"
                           Visibility="Collapsed"/>
      </DataGrid.Columns>
      <DataGrid.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="ResultsContextMenu_Opened"
                     Closed="ResultsContextMenu_Closed">
          <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
          <MenuItem Header="Open Containing Folder" Command="{Binding OpenFolderCommand}"/>
          <MenuItem Header="Open with…">
            <MenuItem Header="Favorite apps"
                      ItemsSource="{Binding OpenWithFavorites}">
              <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem">
                  <Setter Property="Header" Value="{Binding DisplayName}"/>
                  <Setter Property="ToolTip" Value="{Binding ExePath}"/>
                  <Setter Property="Command"
                          Value="{Binding DataContext.OpenWithFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                  <Setter Property="CommandParameter" Value="{Binding ExePath}"/>
                </Style>
              </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Choose another app…" Command="{Binding ChooseOpenWithAppCommand}"/>
          </MenuItem>
          <MenuItem Header="Edit with Notepad++" Command="{Binding EditWithNotepadPpCommand}"/>
          <MenuItem Header="Open path in Command Prompt" Command="{Binding OpenInCmdCommand}"/>
          <MenuItem Header="Open path in Git Bash" Command="{Binding OpenInGitBashCommand}"/>
          <Separator/>
          <MenuItem Header="Show Extension column"
                    IsCheckable="True"
                    IsChecked="{Binding ShowExtensionColumn, Mode=TwoWay}"/>
          <MenuItem Header="Show Attributes column"
                    IsCheckable="True"
                    IsChecked="{Binding ShowAttributesColumn, Mode=TwoWay}"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OpenFolderCommand}"/>
      </DataGrid.InputBindings>
    </DataGrid>
  </DockPanel>
</Window>
