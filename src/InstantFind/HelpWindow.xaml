<Window x:Class="InstantFind.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instant Find — Help"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="560" Width="560"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button Content="Close"
              Click="Close_Click"
              Padding="14,6"
              MinWidth="80"
              HorizontalAlignment="Right"
              DockPanel.Dock="Right"
              Cursor="Hand"
              Background="{StaticResource AccentBrush}"
              Foreground="White"
              BorderBrush="{StaticResource AccentBrush}"
              BorderThickness="1"
              FontWeight="SemiBold"/>
      <TextBlock Text="Help"
                 FontSize="18" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
    </DockPanel>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="Search basics" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="Type part of a name. Results update as you type. ✕ clears the box. Aa = match case. W = whole word. .* = regex on the filename (case still follows Aa). And / Or control how multiple terms combine."/>

          <TextBlock Text="Quoted phrases" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="Put a phrase in double quotes for an exact contiguous match on the name/path (Everything-style): &quot;annual report&quot; matches that phrase, not the words separately. Quote marks are delimiters only — filenames do not need to contain &quot;. Mix with unquoted terms, !NOT, path scope, and macros. Use \&quot; inside a phrase for a literal quote character."/>

          <TextBlock Text="Exclude / hosts" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="Filter → Exclude checkboxes use folder paths (e.g. C:\Windows), not a permanent ban on the name Windows. Uncheck Windows, then Rebuild Index once, to find files such as C:\Windows\System32\drivers\etc\hosts. Extensionless names like hosts match a search for hosts."/>

          <TextBlock Text="Paths" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="A path ending in \ scopes the search to that folder (e.g. C:\Logs\). A leading \ starts a path-segment search (e.g. \72 finds folders/files whose path has a segment starting with 72). Spaces before \72 still scope correctly: C:\Logs  \72."/>

          <TextBlock Text="NOT" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="Prefix a term with ! to exclude it: report !temp   or   !*.tmp"/>

          <TextBlock Text="Size and date" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="size:>1mb   size:0   size:1mb..10mb&#x0a;dm:today   dm:thisweek   dm:thisyear   dm:2024..2026&#x0a;Use the Filter button (left of And/Or) for presets, type groups, and saved filters."/>

          <TextBlock Text="Macros (type shortcuts)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="doc:  img:  vid:  audio:  zip:  code:  xls:  ppt:  exe:  font:  iso:&#x0a;Example: doc: budget"/>

          <TextBlock Text="Results" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="Double-click to open. Right-click for Open with…, Notepad++, Command Prompt, Git Bash, and Show Extension / Attributes columns. Drag rows out to Explorer or other apps. Drive chips toggle which drives appear in results (they do not rebuild the index)."/>

          <TextBlock Text="Exclude folders" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="Filter → Exclude: check common folders (C:\Windows, Program Files, …) or add your own with +. Excluded paths are hidden from results immediately and skipped on the next Rebuild Index."/>

          <TextBlock Text="Index" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"
                     Text="Rebuild Index scans local drives in user mode (SQLite + FileSystemWatcher). Cancel stops a rebuild safely. Instant Find never uses kernel drivers, raw MFT, or USN journal scraping — Crowdstrike-friendly by design."/>

          <TextBlock Text="Keyboard" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" LineHeight="18"
                     Text="Esc — close Filter popup (or focus the search box). Down — jump into results. Esc in this Help window closes it."/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
