<Window x:Class="InstantFind.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instant Find — Help"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="720" Width="780"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="SectionBlurb" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="ExampleLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ExampleNote" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="18">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <Button Content="Close"
              Click="Close_Click"
              Padding="14,6"
              MinWidth="80"
              HorizontalAlignment="Right"
              DockPanel.Dock="Right"
              Cursor="Hand"
              Background="{StaticResource AccentBrush}"
              Foreground="White"
              BorderBrush="{StaticResource AccentBrush}"
              BorderThickness="1"
              FontWeight="SemiBold"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Help" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Quick reference — examples in monospace"
                   FontSize="12"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,2,0,0"/>
      </StackPanel>
    </DockPanel>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="16,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,4,0">
        <StackPanel>

          <!-- Search basics -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Search basics"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Type part of a name. Results update as you type."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="✕"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}" Text="Clear the search box"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="Aa  ·  W  ·  .*"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Match case · whole word · regex on the filename (case follows Aa)"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="And / Or"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="How multiple terms combine (default And)"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Quoted exact name -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Quoted exact file name"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Double quotes match the file name exactly (basename including extension), not a substring. Case follows Aa. Whole Word does not change quoted matching."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text='"hosts"'/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Only a file named hosts — not hostsim or hosts.txt"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text='"annual report.pdf"'/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Exact name including extension; &quot;annual report&quot; alone is name-only"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text='!"hosts"'/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Exclude that exact name; mix with unquoted terms, path scope, macros"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text='\"'/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Literal quote character inside quotes"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Exclude / hosts -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Exclude / hosts"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Filter → Exclude checkboxes use folder paths (e.g. C:\Windows), not a permanent ban on the name Windows."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="Uncheck Windows"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Then Rebuild Index once to find C:\Windows\System32\drivers\etc\hosts"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="hosts"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Extensionless names like hosts match a search for hosts"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Paths -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Paths"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Scope to a folder or match a path segment (Everything-like)."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="C:\Logs\"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Path ending in \ scopes search to that folder"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="\72"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Leading \ — path segment starting with 72"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="C:\Logs  \72"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Spaces before \72 still scope correctly"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- NOT -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="NOT"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Prefix a term with ! to exclude it."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="report !temp"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Must match report, must not match temp"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="!*.tmp"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Exclude wildcard matches"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Size and date -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Size and date"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Filter button (left of And/Or) for presets, type groups, and saved filters."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="size:>10mb"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Also size:0 · size:1mb..10mb"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="dm:today"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Also dm:thisweek · dm:thisyear · dm:2024..2026"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Macros -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Macros (type shortcuts)"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Expand to common extension sets (same as Filter → Type)."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}"
                           Text="doc:  img:  vid:  audio:  zip:  code:  xls:  ppt:  exe:  font:  iso:"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="doc: budget"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Documents whose name matches budget"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Results -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Results"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Work with hits without leaving the search window."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="Double-click"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}" Text="Open the file"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="Right-click"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Open with…, Notepad++, Command Prompt, Git Bash, Show Extension / Attributes"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="Drag row"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Drop into Explorer or other apps"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="Drive chips"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Toggle which drives appear in results (do not rebuild the index)"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Exclude folders -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Exclude folders"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Filter → Exclude: check common folders (C:\Windows, Program Files, …) or add your own with +. Excluded paths are hidden from results immediately and skipped on the next Rebuild Index."/>
            </StackPanel>
          </Border>

          <!-- Index -->
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Index"/>
              <TextBlock Style="{StaticResource SectionBlurb}"
                         Text="Rebuild Index scans local drives in user mode (SQLite + FileSystemWatcher). Cancel stops a rebuild safely."/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="CrowdStrike-safe"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Never uses kernel drivers, raw MFT, or USN journal scraping — user-mode only by design"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Keyboard -->
          <Border Style="{StaticResource SectionCard}" Margin="0">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Keyboard"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="Esc"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Close Filter popup, or focus the search box — Esc here closes Help"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ExampleLabel}" Text="↓"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ExampleNote}"
                           Text="Jump into results"/>
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
